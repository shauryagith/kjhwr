# Gridbricks UK Wind Forecast Analytics Environment Configuration

# Backend settings
APP_NAME="Gridbricks UK Wind Forecast Analytics"
APP_VERSION="1.0.0"
DEBUG=False

# Elexon BMRS API
ELEXON_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
REQUEST_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
BACKOFF_FACTOR=1.5

# Caching & Defaults
CACHE_DIR="backend/data/cache"
ENABLE_CACHE=True
DEFAULT_START_DATE="2026-01-01"
DEFAULT_END_DATE="2026-01-31"
DEFAULT_CUTOFF_TYPE="DA_1100"

# CORS Allowed Origins
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000", "*"]'

# Frontend settings (in frontend/.env)
VITE_API_BASE_URL="/api/v1"
